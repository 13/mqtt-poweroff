[Unit]
Description=MQTT Poweroff Listener (MAC matched)
Documentation=https://github.com/13/mqtt-poweroff
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/mqtt-poweroff
ExecStart=/usr/local/bin/mqtt-poweroff.sh
Restart=always
RestartSec=10
SyslogIdentifier=mqtt-poweroff

# Private directory for the mosquitto client config holding the credentials
RuntimeDirectory=mqtt-poweroff
RuntimeDirectoryMode=0700
UMask=0077

# Hardening — the script only needs network, read access to /sys/class/net,
# netlink for ip/ethtool (Wake-on-LAN, CAP_NET_ADMIN) and the D-Bus socket
# to ask logind/systemd for poweroff (CAP_SYS_BOOT).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_BOOT
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
